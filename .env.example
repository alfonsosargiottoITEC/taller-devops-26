# Application config
APP_ENV=development
SECRET_KEY=change-me
LOG_LEVEL=info
PORT=8000

# Database config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=correos_db
DB_HOST=db
DB_PORT=5432
# If empty, the app builds DATABASE_URL from POSTGRES_* and DB_* values.
DATABASE_URL=
SQLITE_PATH=/tmp/app-correos.sqlite3
DATABASE_CONNECT_TIMEOUT=2

# Email Service (SMTP)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
